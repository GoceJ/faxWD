4. Create the router
js/router.js

const routes = {
    "/": () => import("./pages/home.js"),
    "/osnovi": () => import("./pages/osnovi.js"),
    "/nivelir": () => import("./pages/nivelir.js"),
    "/visinski-sistemi": () => import("./pages/visinski-sistemi.js"),
    "/reperi": () => import("./pages/reperi.js"),
    "/quiz": () => import("./pages/quiz.js")
};

export async function navigate() {
    const path = window.location.hash.slice(1) || "/";
    const app = document.getElementById("app");

    const loadPage = routes[path];

    if (!loadPage) {
        app.innerHTML = "<h1>404 - Страницата не постои</h1>";
        return;
    }

    try {
        const module = await loadPage();

        app.innerHTML = module.default();

        // Update active navigation link
        document.querySelectorAll(".navbar nav a").forEach(link => {
            link.classList.toggle(
                "active",
                link.getAttribute("href") === `#${path}`
            );
        });

        window.scrollTo({ top: 0, behavior: "smooth" });

    } catch (error) {
        console.error(error);
        app.innerHTML = "<h1>Грешка при вчитување на страницата.</h1>";
    }
}



js/app.js

import { navigate } from "./router.js";

// Listen for URL changes
window.addEventListener("hashchange", navigate);

// Load initial page
navigate();



That's your router. Pretty small, right?
